// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// Modelos de Usuario y Autenticación
// --------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          Role    @default(BUYER)
  isActive      Boolean @default(false)

  // Perfil de Trading (Tasas de cambio con precisión)
  allowBuyRateAdjustment Boolean @default(false)

  // Límite de crédito (solo buyers)
  creditLimit Decimal @default(200) @db.Decimal(10, 2)

  // Preferencias de búsqueda de tarjetas
  allowSearchPreferences Boolean  @default(false)
  minAmountPreference    Decimal? @db.Decimal(10, 2)
  maxAmountPreference    Decimal? @db.Decimal(10, 2)

  // Relaciones
  telegramUser      TelegramUser?
  sessions          Session[]
  accounts          Account[]
  giftcards         Giftcard[]
  orders            Order[]
  paymentMethod     PaymentMethod?
  giftcardBatches   GiftcardBatch[]
  reportedIssues    GiftcardIssue[]
  brandCountryRates UserBrandCountryRate[]

  twoFactor        TwoFactor?
  twoFactorEnabled Boolean    @default(false)
  passkeys         Passkey[]

  // Notificaciones
  notificationPreference NotificationPreference?
  notifications          Notification[]
  notificationLogs       NotificationLog[]
  pushSubscriptions      PushSubscription[]

  // Deep link tokens para vinculación Telegram
  telegramLinkTokens TelegramLinkToken[]

  // Logs de aplicación
  logs AppLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --------------------------------------
// Modelos de Negocio (Giftcards & Orders)
// --------------------------------------

model Giftcard {
  id             String         @id @default(cuid())
  brandCountryId String
  brandCountry   BrandCountry   @relation(fields: [brandCountryId], references: [id])
  claimCode      String
  codeHash       String?        @unique
  pinCode        String?
  amount         Decimal        @db.Decimal(10, 2) // Valor nominal (el seller lo define al crear)
  inStock        Boolean        @default(true)
  isConfirmed    Boolean        @default(false)
  status         GiftcardStatus @default(UNUSED)

  // Monto reportado por el buyer (solo cuando status = WRONG_AMOUNT o redimida con diferencia)
  reportedAmount Decimal? @db.Decimal(10, 2)

  // Relaciones
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  batchId Int?
  batch   GiftcardBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  issues GiftcardIssue[]

  provenanceImage ProvenanceImage? @relation(fields: [provenanceImageId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  provenanceImageId String?

  // Sistema de reserva escalonada
  escalationTier Int      @default(85)
  tierStartedAt  DateTime @default(now())
  tierUpdatedAt  DateTime @updatedAt

  @@index([brandCountryId, inStock, status])
  @@index([ownerId])
  @@index([orderId])
  @@index([escalationTier])
  @@map("giftcard")
}

model Brand {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  icon     String // Emoji
  image    String? // Logo path
  isActive Boolean @default(true)

  countries BrandCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand")
}

model Country {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String  @unique
  currency String?
  isActive Boolean @default(true)

  brands BrandCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("country")
}

model BrandCountry {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id])
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  isActive  Boolean  @default(true)
  minAmount Decimal? @db.Decimal(10, 2)
  maxAmount Decimal? @db.Decimal(10, 2)

  claimCodePattern String?  // Regex to validate claim codes (tested against normalized code without hyphens/spaces)

  orders    Order[]
  giftcards Giftcard[]
  userRates UserBrandCountryRate[]

  // Suscripciones de Notificaciones de stock (buyers)
  subscriptions BrandCountrySubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, countryId])
  @@map("brand_country")
}

model Order {
  id            String      @id @default(cuid())
  total         Decimal     @db.Decimal(10, 2) // Total original al crear la orden
  adjustedTotal Decimal?    @db.Decimal(10, 2) // Total recalculado post-redeem (con issues)
  buyRate       Decimal     @db.Decimal(10, 4)
  status        OrderStatus
  idempotencyKey String?  @unique

  userId         String
  brandCountryId String?
  user           User            @relation(fields: [userId], references: [id])
  brandCountry   BrandCountry?   @relation(fields: [brandCountryId], references: [id])
  giftcards      Giftcard[]
  payments       Payment[]
  issues         GiftcardIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([brandCountryId])
  @@map("order")
}

model GiftcardBatch {
  id          Int        @id @default(autoincrement())
  sellRate    Decimal    @db.Decimal(10, 4)
  isPaid      Boolean    @default(false)
  cancelledAt DateTime?

  // Relaciones
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
  giftcards Giftcard[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("giftcard_batch")
}

model ProvenanceImage {
  id             String     @id @default(cuid())
  data           Bytes? // AES-256-GCM encrypted image buffer
  mimeType       String? // "image/jpeg" post-compression
  size           Int? // Original file size for audit
  giftcardId     String? // Puede ser null si no se linked
  batchId        String? // Todas las imágenes van al batch
  telegramFileId String? // Added for Telegram Bot image uploads
  createdAt      DateTime   @default(now())
  giftcards      Giftcard[]

  @@map("provenance_image")
}

model Payment {
  id              String           @id @default(cuid())
  amount          Decimal          @db.Decimal(10, 2)
  balanceAfter    Decimal          @default(0) @db.Decimal(10, 2)
  direction       PaymentDirection
  category        PaymentCategory
  status          PaymentStatus    @default(COMPLETED)
  transactionId   String?
  binanceTxId     String?  @unique
  isBinanceWallet Boolean  @default(false)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  batchId Int?
  batch   GiftcardBatch? @relation(fields: [batchId], references: [id])

  relatedUserId String?
  notes         String?
  referenceType PaymentReferenceType?
  referenceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([batchId])
  @@index([status, category])
  @@map("payment")
}

enum PaymentReferenceType {
  ORDER
  BATCH
  MANUAL
}

model PaymentMethod {
  id              String  @id @default(cuid())
  address         String
  isBinanceWallet Boolean @default(false)

  coinId    String
  coin      Coin    @relation(fields: [coinId], references: [id])
  networkId String
  network   Network @relation(fields: [networkId], references: [id])

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_method")
}

model GiftcardIssue {
  id        String            @id @default(cuid())
  issueType GiftcardIssueType

  // Monto reportado por el buyer (solo para WRONG_AMOUNT)
  reportedAmount Decimal? @db.Decimal(10, 2)

  // Prueba opcional (screenshot del balance/error)
  proofImageUrl String?

  // Relaciones
  giftcardId String
  giftcard   Giftcard @relation(fields: [giftcardId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Buyer que reportó el issue
  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  // Seller dueño de la tarjeta (para auditoría y filtrado)
  sellerId String?

  createdAt DateTime @default(now())

  @@map("giftcard_issue")
}

model PlatformSettings {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
  balance     Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// --------------------------------------
// AI Vision Provider Configuration
// --------------------------------------

model AIProviderConfig {
  id        String  @id @default(cuid())
  name      String  @unique
  label     String
  model     String
  baseUrl   String?
  apiKey    String // AES-256-GCM encrypted
  isActive  Boolean @default(false)
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_provider_config")
}

// --------------------------------------
// Catálogo de Coins y Redes
// --------------------------------------

model Coin {
  id       String  @id @default(cuid())
  name     String  // "Tether"
  symbol   String  @unique // "USDT"
  decimals Int     @default(6)
  isActive Boolean @default(true)

  networks       CoinNetwork[]
  paymentMethods PaymentMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coin")
}

model Network {
  id          String  @id @default(cuid())
  name        String  @unique // "BSC", "TRX", "MATIC", "AVAXC", "PLASMA"
  description String  // "BNB Smart Chain BEP20"
  regex       String  // Regex para validar direcciones de wallet
  isActive    Boolean @default(true)

  coins          CoinNetwork[]
  paymentMethods PaymentMethod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("network")
}

model CoinNetwork {
  id        String  @id @default(cuid())
  coinId    String
  coin      Coin    @relation(fields: [coinId], references: [id], onDelete: Cascade)
  networkId String
  network   Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@unique([coinId, networkId])
  @@map("coin_network")
}

// --------------------------------------
// Enums
// --------------------------------------

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum GiftcardStatus {
  USED
  UNUSED
  ALREADY_USED
  INVALID
  DEACTIVATED
  WRONG_AMOUNT
}

enum GiftcardIssueType {
  INVALID
  ALREADY_USED
  DEACTIVATED
  WRONG_AMOUNT
}

enum PaymentDirection {
  CREDIT
  DEBIT
}

enum PaymentCategory {
  ORDER
  BATCH
  DEPOSIT
  WITHDRAWAL
  REFUND_BUYER
  REFUND_SELLER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

// Requerido por el plugin passkey de Better Auth (WebAuthn)
model Passkey {
  id           String  @id @default(cuid())
  name         String?
  publicKey    String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("passkey")
}

model TelegramUser {
  id            String  @id @default(cuid())
  telegramId    String  @unique
  firstName     String?
  lastName      String?
  username      String?
  languageCode  String?
  photoData     Bytes? // AES-256-GCM encrypted image buffer
  photoMimeType String? // "image/jpeg"

  // message_thread_id del topic "🔔 Notificaciones" en el chat privado del bot (forum topic mode, Bot API 10.x)
  // INVARIANTE: los topic ids son por (bot, chat) — siempre validar notificationChatId antes de usar notificationTopicId
  notificationTopicId Int?
  // chat.id donde se creó notificationTopicId (String porque los chat ids de Telegram exceden Int32)
  notificationChatId  String?

  // message_thread_id del topic "🤖 Menú" (interacción del bot) en el chat privado
  // INVARIANTE: los topic ids son por (bot, chat) — siempre validar flowChatId antes de usar flowTopicId
  flowTopicId Int?
  // chat.id donde se creó flowTopicId (String porque los chat ids de Telegram exceden Int32)
  flowChatId  String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("telegram_user")
}

// Bot session persistence for @grammyjs/storage-prisma
model BotSession {
  key       String   @id // formato: "seller:<telegramId>" | "buyer:<telegramId>"
  value     String // JSON serializado por @grammyjs/storage-prisma
  updatedAt DateTime @updatedAt

  @@map("bot_session")
}

// OTP temporal para registro via Telegram bot
model TelegramOtp {
  id         String   @id @default(cuid())
  telegramId String   @unique
  email      String
  name       String
  otp        String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@map("telegram_otp")
}

// Deep link token para vincular Telegram desde la web (one-time use, 24h expiry)
model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@map("telegram_link_token")
}

model UserBrandCountryRate {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandCountryId String
  brandCountry   BrandCountry @relation(fields: [brandCountryId], references: [id], onDelete: Cascade)
  buyRate        Decimal      @db.Decimal(10, 4)
  sellRate       Decimal      @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brandCountryId])
  @@map("user_brand_country_rate")
}

// --------------------------------------
// Sistema de Notificaciones Multicanal
// --------------------------------------

model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Channels
  telegramEnabled Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  whatsappPhone   String?  // E.164 (+1234567890)
  pushEnabled     Boolean  @default(false) // Web Push (navegador)

  // Suscripciones explícitas a brand-countries (buyers que quieren Notificaciones de stock nuevo)
  subscriptions BrandCountrySubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preference")
}

model BrandCountrySubscription {
  id             String @id @default(cuid())
  preferenceId   String
  preference     NotificationPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  brandCountryId String
  brandCountry   BrandCountry @relation(fields: [brandCountryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([preferenceId, brandCountryId])
  @@map("brand_country_subscription")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  description String
  read        Boolean          @default(false)
  actionUrl   String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read])
  @@map("notification")
}

// Suscripciones Web Push (Push API) — un usuario puede tener varios dispositivos
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscription")
}

// Tracking anti-spam: evita re-notificar el mismo evento al mismo usuario
model NotificationLog {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  referenceType String           // 'BRAND_COUNTRY' | 'GIFTCARD' | 'BATCH' | 'ORDER'
  referenceId   String

  createdAt DateTime @default(now())

  @@unique([userId, type, referenceType, referenceId])
  @@index([userId, type])
  @@map("notification_log")
}

// --------------------------------------
// WhatsApp Baileys (Auth State + Session)
// --------------------------------------

model WhatsappAuthState {
  id        String   @id @default(cuid())
  key       String   @unique
  data      String   // JSON serializado (creds, pre-keys, etc.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("whatsapp_auth_state")
}

model WhatsappSession {
  id          String   @id @default(cuid())
  status      String   @default("disconnected") // "connecting" | "open" | "disconnected"
  phoneNumber String?
  qrCode      String?  // Base64 del QR actual (null cuando está conectado)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_session")
}

enum NotificationType {
  STOCK_AVAILABLE
  TIER_DROP_ACCESS
  PAYMENT_PENDING
  ORDER_COMPLETED
  BATCH_PAID
  BATCH_CANCELLED
  BATCH_DELETED
  BATCH_STATUS
  BATCH_UNDER_REVIEW
  RATE_UPDATE
}

// --------------------------------------
// Sistema de Logging
// --------------------------------------

model AppLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  level     String   // "info" | "warn" | "error" | "debug"
  source    String   // "web" | "seller-bot" | "buyer-bot" | "cron" | "system"
  flow      String?  // "sell" | "buy" | "order" | "payment" | "batch" | "auth"
  action    String?  // "publish-batch" | "create-order" | "complete-payment" | etc.
  message   String
  userId    String?
  metadata  Json?
  error     Json?    // { name, message, stack }
  ip        String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([source])
  @@index([flow])
  @@index([userId])
  @@index([timestamp])
  @@index([source, flow, timestamp])
  @@map("app_log")
}
