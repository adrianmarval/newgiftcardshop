// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------
// Modelos de Usuario y Autenticación
// --------------------------------------

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          Role    @default(BUYER)

  // Perfil de Trading (Tasas de cambio con precisión)
  buyRate  Decimal @default(0.85) @db.Decimal(10, 4)
  sellRate Decimal @default(0.75) @db.Decimal(10, 4)

  // Relaciones
  sessions        Session[]
  accounts        Account[]
  giftcards       Giftcard[]
  orders          Order[]
  paymentMethod   PaymentMethod?
  giftcardBatches GiftcardBatch[]
  reportedIssues  GiftcardIssue[]

  twoFactor        TwoFactor?
  twoFactorEnabled Boolean    @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --------------------------------------
// Modelos de Negocio (Giftcards & Orders)
// --------------------------------------

model Giftcard {
  id             String         @id @default(cuid())
  brandCountryId String
  brandCountry   BrandCountry   @relation(fields: [brandCountryId], references: [id])
  claimCode      String
  codeHash       String?        @unique
  pinCode        String?
  amount         Decimal        @db.Decimal(10, 2) // Valor nominal (el seller lo define al crear)
  inStock        Boolean        @default(true)
  isConfirmed    Boolean        @default(false)
  status         GiftcardStatus @default(UNUSED)

  // Monto reportado por el buyer (solo cuando status = WRONG_AMOUNT o redimida con diferencia)
  reportedAmount Decimal? @db.Decimal(10, 2)

  // Relaciones
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  batchId Int?
  batch   GiftcardBatch? @relation(fields: [batchId], references: [id])

  issues GiftcardIssue[]

  provenanceImage ProvenanceImage? @relation(fields: [provenanceImageId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  provenanceImageId String?

  @@map("giftcard")
}

model Brand {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  icon     String // Emoji
  image    String? // Logo path
  isActive Boolean @default(true)

  countries BrandCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand")
}

model Country {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String  @unique
  currency String?
  isActive Boolean @default(true)

  brands BrandCountry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("country")
}

model BrandCountry {
  id        String  @id @default(cuid())
  brandId   String
  brand     Brand   @relation(fields: [brandId], references: [id])
  countryId String
  country   Country @relation(fields: [countryId], references: [id])

  isActive  Boolean  @default(true)
  minAmount Decimal? @db.Decimal(10, 2)
  maxAmount Decimal? @db.Decimal(10, 2)

  giftcards Giftcard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, countryId])
  @@map("brand_country")
}

model Order {
  id            String      @id @default(cuid())
  total         Decimal     @db.Decimal(10, 2) // Total original al crear la orden
  adjustedTotal Decimal?    @db.Decimal(10, 2) // Total recalculado post-redeem (con issues)
  buyRate       Decimal     @db.Decimal(10, 4)
  status        OrderStatus

  userId    String
  user      User            @relation(fields: [userId], references: [id])
  giftcards Giftcard[]
  payments  Payment[]
  issues    GiftcardIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order")
}

model GiftcardBatch {
  id       Int     @id @default(autoincrement())
  sellRate Decimal @db.Decimal(10, 4)
  isPaid   Boolean @default(false)

  // Relaciones
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
  giftcards Giftcard[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("giftcard_batch")
}

model ProvenanceImage {
  id         String     @id @default(cuid())
  data       Bytes // AES-256-GCM encrypted image buffer
  mimeType   String // "image/jpeg" post-compression
  size       Int // Original file size for audit
  giftcardId String? // Puede ser null si no se linked
  batchId    String? // Todas las imágenes van al batch
  createdAt  DateTime   @default(now())
  giftcards  Giftcard[]

  @@map("provenance_image")
}

model Payment {
  id              String          @id @default(cuid())
  amount          Decimal         @db.Decimal(10, 2)
  balanceAfter    Decimal         @default(0) @db.Decimal(10, 2)
  status          PaymentStatus
  transactionType TransactionType
  transactionId   String?

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  batchId Int?
  batch   GiftcardBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
}

model PaymentMethod {
  id      String            @id @default(cuid())
  coin    SupportedCoins
  address String
  network SupportedNetworks

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_method")
}

model GiftcardIssue {
  id        String            @id @default(cuid())
  issueType GiftcardIssueType

  // Monto reportado por el buyer (solo para WRONG_AMOUNT)
  reportedAmount Decimal? @db.Decimal(10, 2)

  // Prueba opcional (screenshot del balance/error)
  proofImageUrl String?

  // Relaciones
  giftcardId String
  giftcard   Giftcard @relation(fields: [giftcardId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Buyer que reportó el issue
  reportedById String
  reportedBy   User   @relation(fields: [reportedById], references: [id])

  // Seller dueño de la tarjeta (para auditoría y filtrado)
  sellerId String?

  createdAt DateTime @default(now())

  @@map("giftcard_issue")
}

model PlatformSettings {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// --------------------------------------
// Enums
// --------------------------------------

enum Role {
  ADMIN
  SELLER
  BUYER
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum GiftcardStatus {
  USED
  UNUSED
  ALREADY_USED
  INVALID
  DEACTIVATED
  WRONG_AMOUNT
}

enum GiftcardIssueType {
  INVALID
  ALREADY_USED
  DEACTIVATED
  WRONG_AMOUNT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum SupportedNetworks {
  BSC
  TRX
  MATIC
  AVAXC
  PLASMA
}

enum SupportedCoins {
  USDT
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String @unique
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}
