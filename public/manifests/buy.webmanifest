{
  "name": "Solmaira GiftCardShop",
  "short_name": "GiftcardShop Buy",
  "description": "Buy and sell gift cards at the best rates",
  "id": "/store/dashboard",
  "start_url": "/store/dashboard",
  "scope": "/store",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://dev.giftcardshop.app/manifests/buy.webmanifest",
      "id": "/store/dashboard"
    }
  ],
  "prefer_related_applications": false
}
