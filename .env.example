# ── APP IDENTITY ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Solmaira GiftCardShop"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@giftcardshop.app"

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ── AUTHENTICATION (Better Auth) ──────────────────────────────────────────────
# Generar secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── EMAILS (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM_NAME="Solmaira GiftCardShop"
EMAIL_FROM_ADDRESS="onboarding@giftcardshop.app"

# ── SECURITY ──────────────────────────────────────────────────────────────────
# Clave hexadecimal de 64 caracteres (32 bytes) para cifrado de datos sensibles
ENCRYPTION_KEY=""

# ── AI & OCR VISION ───────────────────────────────────────────────────────────
# Proveedor por defecto: anthropic | openai | openrouter | gemini | ollama | opencodego
PROVENANCE_PROVIDER="openrouter"
# Modelo a utilizar (ej: google/gemini-2.0-flash-001, claude-3-5-sonnet-20240620)
PROVENANCE_MODEL="google/gemini-2.0-flash-001"

# API Keys para proveedores de IA (el sistema usará la correspondiente al proveedor elegido)
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
AI_API_KEY="" # Fallback general si no se especifican las anteriores

# ── BINANCE & FINANCE ─────────────────────────────────────────────────────────
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
WITHDRAW_WALLET=""
WITHDRAW_COIN="USDT"
WITHDRAW_NETWORK="TRX"

# ── TELEGRAM BOTS ─────────────────────────────────────────────────────────────
# Tokens obtenidos de @BotFather
SELLER_BOT_TOKEN=""
BUYER_BOT_TOKEN=""

# Secret token para validar webhooks de Telegram (generar con: openssl rand -hex 32)
# Requerido en producción para prevenir updates forjados
WEBHOOK_SECRET_TOKEN=""

# Usernames de los bots (sin @) para deep links
SELLER_BOT_USERNAME=""
BUYER_BOT_USERNAME=""

# Username de Telegram del administrador (sin @) para soporte y activaciones
ADMIN_TELEGRAM_USERNAME="adrianmarval"

# ── INFRASTRUCTURE (Optional) ────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"