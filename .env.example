# Database Connection String (Use docker compose up -d)
DATABASE_URL="postgresql://username:password@localhost:5444/prismadb?schema=public"

#A secret value used for encryption and hashing. It must be at least 32 characters and generated with high entropy.
#You can also use openssl rand -base64 32 to generate one.
BETTER_AUTH_SECRET=

# Url base de la aplicacion
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app

# 32-byte hex key used for AES-256-GCM encryption of gift card claim codes and pin codes.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Clave api de resend para envio de correos.
RESEND_API_KEY

# OpenRouter API key (https://openrouter.ai)
OPENROUTER_API_KEY=

# OpenCode Go API key (https://opencode.ai) — supports GLM-5.1, Kimi K2.5, MiMo-V2, etc.
OPENCODE_GO_API_KEY=

# AI provider for OCR extraction: openrouter | opencodego | openai | anthropic | gemini | ollama
OCR_PROVIDER="opencodego"

BINANCE_API_KEY="[ENCRYPTION_KEY]"
BINANCE_API_SECRET="[SECRET]"

WITHDRAW_WALLET="TPiBgm7XzeoyNUMeGkDTZAe5eahByPFZjw"
WITHDRAW_COIN='USDT'
